+/* Lazy sweep. garbage_collect() only marks. The sweep then runs in
+ * small steps from rb_newobj(), so one collection does not stop the
+ * game for the whole sweep. Heaps [0, sweep_heaps_end) existed at the
+ * mark. Slots before sweep_p in heap sweep_heap, and the slots of the
+ * heaps before it, are swept. While a sweep is pending, only swept
+ * slots and the slots of heaps added after the mark can be on the
+ * freelist. An unswept slot with flags 0 is free, and the sweep puts
+ * it on the freelist. */
+static int sweep_heap = -1;
+static int sweep_heaps_end;
+static RVALUE *sweep_p;
+static int sweep_n;
+static RVALUE *sweep_final_list, *sweep_final_tail;
+static int sweep_freed;
+static unsigned long sweep_live;
+static unsigned long sweep_free_min;
+static unsigned long sweep_malloc_increase;
+
+#define SWEEP_STEP_FREE  2048
+#define SWEEP_STEP_SLOTS 32768
+
+static int
+is_swept(p)
+    RVALUE *p;
+{
+    int i;
+
+    if (sweep_heap < 0) return Qtrue;
+    for (i = 0; i < sweep_heaps_end; i++) {
+	if (heaps[i].slot <= p && p < heaps[i].slot + heaps[i].limit) {
+	    if (i < sweep_heap) return Qtrue;
+	    if (i > sweep_heap) return Qfalse;
+	    return p < sweep_p;
+	}
+    }
+    return Qtrue;
+}
+
+static void gc_sweep_step _((int));
+
+static void
+gc_sweep_rest()
+{
+    while (sweep_heap >= 0) {
+	gc_sweep_step(0);
+    }
+}
