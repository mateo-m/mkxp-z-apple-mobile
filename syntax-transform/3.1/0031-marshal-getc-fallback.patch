# In Ruby 1.8, `Marshal.load(io)` read one byte at a time via `IO#getc`,
# which returned the byte as an Integer. In Ruby 1.9+, `IO#getc` was
# redefined to return a String (single character) and a new `IO#getbyte`
# method was added to return the Integer. `Marshal.load` was switched to
# call `getbyte`.
#
# RGSS games commonly ship their own IO-like class (e.g. Pokemon
# Essentials' `StringInput` wrapping a String) that implements the 1.8
# contract: `getc` returning an Integer, with no `getbyte` defined. On
# Ruby 1.9+, `Marshal.load` on such objects raises
# `IOError: uninitialized stream` (via `io_needed()`) because the object
# does not respond to `getbyte`.
#
# When the syntax transform target is Ruby <= 1.8, this patch makes
# `Marshal.load` also accept objects that only implement `getc`/`read`,
# and route byte reads through `getc` instead of `getbyte`. Either an
# Integer (1.8 contract) or a single-char String (3.x contract) return
# value is accepted. This matches Ruby 1.8's behavior without requiring
# game code to add a `getbyte` alias.
#
# Note: the checks read `mkxp_syntax_transform_target_ruby_version_major`
# directly rather than calling `mkxp_ec_is_syntax_transform_active(1, 8,
# -1)`. `Marshal.load` is dispatched through `<internal:marshal>` whose
# iseq is not compiled with the per-frame transform flag, so the ec-based
# check walks up to the first Ruby frame and sees it as FALSE even when
# the caller's frame was transformed.

--- a/marshal.c
+++ b/marshal.c
@@ -96,7 +96,7 @@ static ID s_dump, s_load, s_mdump, s_mload;
 static ID s_dump_data, s_load_data, s_alloc, s_call;
 static ID s_getbyte, s_read, s_write, s_binmode;
 
-static ID s_encoding_short, s_ruby2_keywords_flag;
+static ID s_encoding_short, s_ruby2_keywords_flag, s_getc;
 
 #define name_s_dump	"_dump"
 #define name_s_load	"_load"
@@ -106,6 +106,7 @@ static ID s_encoding_short, s_ruby2_keywords_flag;
 #define name_s_alloc	"_alloc"
 #define name_s_call	"call"
 #define name_s_getbyte	"getbyte"
+#define name_s_getc	"getc"
 #define name_s_read	"read"
 #define name_s_write	"write"
 #define name_s_binmode	"binmode"
@@ -1269,6 +1270,21 @@ r_byte(struct load_arg *arg)
 	    c = r_byte1_buffered(arg);
 	}
 	else {
+	    {
+	        extern unsigned int mkxp_syntax_transform_target_ruby_version_major;
+	        if (mkxp_syntax_transform_target_ruby_version_major <= 1 && rb_respond_to(arg->src, s_getc)) {
+	            VALUE v = load_funcall(arg, arg->src, s_getc, 0, 0);
+	            if (NIL_P(v)) rb_eof_error();
+	            if (RB_TYPE_P(v, T_STRING)) {
+	                if (RSTRING_LEN(v) == 0) rb_eof_error();
+	                c = (unsigned char)RSTRING_PTR(v)[0];
+	            }
+	            else {
+	                c = (unsigned char)NUM2CHR(v);
+	            }
+	            return c;
+	        }
+	    }
 	    VALUE v = load_funcall(arg, arg->src, s_getbyte, 0, 0);
 	    if (NIL_P(v)) rb_eof_error();
 	    c = (unsigned char)NUM2CHR(v);
@@ -2219,8 +2235,14 @@ rb_marshal_load_with_proc(VALUE port, VALUE proc, bool freeze)
     else if (rb_respond_to(port, s_getbyte) && rb_respond_to(port, s_read)) {
 	rb_check_funcall(port, s_binmode, 0, 0);
     }
     else {
-	io_needed();
+        extern unsigned int mkxp_syntax_transform_target_ruby_version_major;
+        if (mkxp_syntax_transform_target_ruby_version_major <= 1 && rb_respond_to(port, s_getc) && rb_respond_to(port, s_read)) {
+            rb_check_funcall(port, s_binmode, 0, 0);
+        }
+        else {
+            io_needed();
+        }
     }
     wrapper = TypedData_Make_Struct(0, struct load_arg, &load_arg_data, arg);
     arg->src = port;
@@ -2391,6 +2413,7 @@ Init_marshal(void)
     set_id(s_dump_data);
     set_id(s_load_data);
     set_id(s_alloc);
+    set_id(s_getc);
     set_id(s_call);
     set_id(s_getbyte);
     set_id(s_read);
